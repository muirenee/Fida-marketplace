{
  "name": "fida-marketplace",
  "private": true,
  "version": "0.4.0",
  "packageManager": "pnpm@10.15.0",
  "scripts": {
    "dev:infra": "docker compose -f infra/docker-compose.yml up -d",
    "stop:infra": "docker compose -f infra/docker-compose.yml down",
    "db:generate": "prisma generate --config prisma.config.ts && node scripts/generate-admin-catalog.mjs",
    "db:push": "prisma db push --config prisma.config.ts",
    "db:migrate": "prisma migrate dev --config prisma.config.ts",
    "db:seed": "tsx packages/database/prisma/seed.ts",
    "db:backfill-logistics": "tsx packages/database/prisma/backfill-logistics.ts",
    "typecheck:api": "tsc -p apps/api/tsconfig.json --noEmit",
    "test:integration": "node --import tsx tests/merchant-origin.mts && node --import tsx tests/business-integration.mts && node --import tsx tests/upgrade-08.mts && node --import tsx tests/upgrade-09.mts"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@electric-sql/pglite-socket": "^0.2.11",
    "@types/node": "^24.3.0",
    "prisma": "^7.10.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
