DATABASE_URL=postgresql://fida:fida@localhost:5432/fida_marketplace?schema=public
REDIS_URL=redis://localhost:6379
JWT_ACCESS_SECRET=replace-with-a-random-secret-of-at-least-32-characters
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_DAYS=30
CORS_ORIGIN=http://localhost:3000
APP_ENV=development
PORT=3001

# Optional local seed administrator. Set both values before running pnpm db:seed.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=replace-with-a-strong-local-password
