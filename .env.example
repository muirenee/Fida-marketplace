# Docker Compose database settings
POSTGRES_DB=fida_marketplace
POSTGRES_USER=fida_app
POSTGRES_PASSWORD=replace-with-a-strong-random-password

# When running through Docker Compose, use the postgres and redis service names.
DATABASE_URL=postgresql://fida_app:replace-with-a-strong-random-password@postgres:5432/fida_marketplace?schema=public
REDIS_URL=redis://redis:6379

# API authentication/session settings
JWT_ACCESS_SECRET=replace-with-a-random-secret-of-at-least-32-characters
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_DAYS=30

# Browser origin allowed to call the API directly. The admin web uses a server-side
# proxy, but keep this aligned with the public admin origin for any direct web calls.
CORS_ORIGIN=http://localhost:3000
APP_ENV=development
PORT=3001

# Host interface used to publish the API container. Keep 127.0.0.1 for a local
# reverse proxy, or set the server/NetBird-reachable IP for a remote proxy.
API_BIND_ADDRESS=127.0.0.1

# Host interface used to publish the Admin web container.
# For the current NetBird deployment this can be the same server IP as the API.
ADMIN_BIND_ADDRESS=127.0.0.1

# Optional seed administrator. Set both values before running pnpm db:seed.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=replace-with-a-strong-local-password

# Product images: persist this directory (Compose mounts the fida_media volume).
MEDIA_DIRECTORY=./uploads
PUBLIC_BASE_URL=https://marketplaceadmin.fidalix.com
# Set this to the exact public portal URL (including scheme and any port).
# The portal uses its origin to validate browser saves, login and logout.

# Optional Firebase Admin service account JSON. Store as a deployment secret.
# Without this and the three mobile Firebase configs, push delivery is disabled.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Optional Flutterwave v3 hosted checkout. Both are required to enable card/MoMo.
# Start with provider test credentials; webhook path: /v1/payments/webhook
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_SECRET=
